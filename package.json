{
  "name": "compta",
  "version": "0.1.0",
  "description": "Tableau de bord comptable automatisé : dépôt de relevés, analyse IA quotidienne, PWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pipeline": "tsx pipeline/run.ts",
    "pipeline:dry": "tsx pipeline/run.ts --dry-run",
    "icons": "node scripts/icons.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/engoB/compta.git"
  },
  "author": "",
