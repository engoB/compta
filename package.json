    "url": "https://github.com/engoB/compta/issues"
  },
  "homepage": "https://github.com/engoB/compta#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "google-auth-library": "^11.3.1",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
